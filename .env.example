# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (Root .env)
# Location: ./ .env or ./ .env.local
# Note: All variables must be prefixed with VITE_ to be accessed in React
# ==========================================

# 1. Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# 2. Backend API URLs
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_EVENTS_API_URL=http://localhost:5000/api/events

# 3. Razorpay Key (Public Key ID)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
