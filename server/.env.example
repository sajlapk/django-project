# Server Configuration
BACKEND_PORT=5000
FRONTEND_PORT=5173

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/discipl
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/discipl?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/discipl

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Support Email (Nodemailer)
SUPPORT_EMAIL_USER=your_email@gmail.com
SUPPORT_EMAIL_PASS=your_email_app_password
